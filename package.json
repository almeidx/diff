{
	"name": "diff",
	"version": "1.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"build:typecheck": "tsc --noEmit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "wrangler deploy",
		"dev": "vite dev",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "svelte-kit sync && oxlint && oxfmt --check",
		"preview": "wrangler dev",
		"test": "vitest run",
		"test:ci": "pnpm test",
		"test:e2e": "pnpm test:smoke",
		"test:smoke": "svelte-kit sync && playwright test",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@pierre/diffs": "^1.6.4",
		"@pierre/trees": "^1.0.0",
		"@zag-js/combobox": "^1.47.0",
		"@zag-js/svelte": "^1.47.0",
		"diff": "^9.0.0",
		"fflate": "^0.8.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.161.0"
	},
	"packageManager": "pnpm@12.18.0"
}
