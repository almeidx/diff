{
	"name": "diff",
	"version": "1.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "wrangler deploy",
		"dev": "vite dev",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "svelte-kit sync && oxlint && oxfmt --check",
		"preview": "wrangler dev",
		"test": "vitest run",
		"test:smoke": "svelte-kit sync && playwright test",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@pierre/diffs": "^1.7.2",
		"@pierre/trees": "^1.0.0",
		"@zag-js/combobox": "^1.49.0",
		"@zag-js/svelte": "^1.49.0",
		"diff": "^9.0.0",
		"fflate": "^0.8.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.11",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2009",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.4.0",
		"vitest": "^5.1.2",
		"wrangler": "^4.168.0"
	},
	"packageManager": "pnpm@12.23.0"
}
