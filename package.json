{
	"name": "diff",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:typecheck": "tsc --noEmit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "wrangler deploy",
		"dev": "vite dev",
		"fmt": "oxfmt && oxlint --fix",
		"lint": "oxfmt --check && oxlint --deny-warnings",
		"preview": "wrangler dev",
		"test": "vitest run",
		"test:ci": "pnpm test",
		"test:e2e": "pnpm test:smoke",
		"test:watch": "vitest",
		"test:smoke": "svelte-kit sync && playwright test"
	},
	"dependencies": {
		"@pierre/diffs": "^1.5.1",
		"@pierre/trees": "^1.0.0-beta.6",
		"@zag-js/combobox": "^1.44.0",
		"@zag-js/radio-group": "^1.44.0",
		"@zag-js/svelte": "^1.44.0",
		"@zag-js/switch": "^1.44.0",
		"diff": "^9.0.0",
		"fflate": "^0.8.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.8",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"wrangler": "^4.140.0"
	},
	"packageManager": "pnpm@12.6.0"
}
